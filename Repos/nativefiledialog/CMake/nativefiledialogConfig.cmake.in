@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

if(UNIX AND NOT APPLE)
    # Recreate the imported target referenced by nativefiledialogTargets.cmake.
    find_dependency(PkgConfig)
    pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET
        NO_CMAKE_PATH
        NO_CMAKE_ENVIRONMENT_PATH
        gtk+-3.0
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nativefiledialogTargets.cmake")
